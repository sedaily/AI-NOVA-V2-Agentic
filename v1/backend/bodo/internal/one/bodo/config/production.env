# w1.sedaily.ai Production Environment Configuration
# AWS Bedrock + Perplexity Web Search
# 최종 업데이트: 2026-01-24

# ========================================
# 환경 정보
# ========================================
ENV=production
SERVICE_NAME=w1.sedaily.ai
AWS_REGION=us-east-1

# ========================================
# AI Provider Configuration (Primary: Bedrock)
# ========================================
AI_PROVIDER=bedrock
USE_ANTHROPIC_API=false
ANTHROPIC_SECRET_NAME=bodo-v1
ANTHROPIC_MODEL_ID=claude-opus-4-5-20251101
FALLBACK_TO_BEDROCK=true
MAX_TOKENS=4096
TEMPERATURE=0.3

# ========================================
# Bedrock Configuration (Primary)
# ========================================
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-5-20251101-v1:0
BEDROCK_MAX_TOKENS=16384
BEDROCK_TEMPERATURE=0.3

# ========================================
# Web Search Configuration (Perplexity API)
# ========================================
ENABLE_NATIVE_WEB_SEARCH=true
USE_OPUS_MODEL=true
PERPLEXITY_SECRET_NAME=nexus/perplexity-api-key

# ========================================
# Application Settings
# ========================================
LOG_LEVEL=INFO
CACHE_TTL=300