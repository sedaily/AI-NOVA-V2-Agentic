# ==================================================
# Nexus AI Agent 환경 변수 설정
# ==================================================

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Model
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514

# ==================================================
# 로컬 개발 환경 (docker-compose 사용 시)
# ==================================================
# Aurora PostgreSQL (pgvector)
DATABASE_URL=postgresql://nexus_user:nexus_dev_password@localhost:5432/nexus_kb
AURORA_HOST=localhost
AURORA_PORT=5432
AURORA_DB=nexus_kb
AURORA_USER=nexus_user
AURORA_PASSWORD=nexus_dev_password

# DynamoDB (로컬)
USE_LOCAL_DYNAMODB=true
DYNAMODB_ENDPOINT=http://localhost:8000

# Redis
REDIS_URL=redis://localhost:6379

# ==================================================
# 프로덕션 환경 (AWS)
# ==================================================
# AURORA_HOST=your-aurora-cluster.region.rds.amazonaws.com
# AURORA_PASSWORD=your-secure-password
# USE_LOCAL_DYNAMODB=false
# DYNAMODB_ENDPOINT=

# ==================================================
# DynamoDB 프롬프트 테이블
# ==================================================
DYNAMO_BODO_TABLE=sedaily-bodo-prompts
DYNAMO_TITLE_TABLE=sedaily-title-prompts
DYNAMO_PROOF_TABLE=sedaily-proofreading-prompts
DYNAMO_REGRESSION_TABLE=sedaily-regression-prompts

# ==================================================
# AgentCore Memory (AWS Managed)
# ==================================================
AGENTCORE_MEMORY_ID=

# ==================================================
# External APIs
# ==================================================
BIGKINDS_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
NANOBANANA_API_KEY=
SERPAPI_KEY=

# ==================================================
# S3 Buckets
# ==================================================
S3_TTS_BUCKET=sedaily-tts-audio
S3_IMAGE_BUCKET=sedaily-news-images

# ==================================================
# Server
# ==================================================
PORT=8001
DEBUG=true
